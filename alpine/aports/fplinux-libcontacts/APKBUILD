# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-libcontacts
pkgver=1
pkgrel=0
pkgdesc="vCard contacts storage and lookup library for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="LGPL-2.1-or-later"
makedepends_build="clang22 lld22"
makedepends_host="musl-dev linux-headers gcc"
subpackages="$pkgname-dev"
options="!check"
source="
	contacts.c
	fplinux-contacts.h
	fplinux-contacts.pc
	fplinux-contacts.map
"
builddir="$srcdir"

build() {
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror -fPIC \
		-shared contacts.c $LDFLAGS \
		-Wl,--version-script=fplinux-contacts.map \
		-Wl,-soname,libfplinux-contacts.so.1 \
		-o libfplinux-contacts.so.1
}

package() {
	install -Dm755 libfplinux-contacts.so.1 \
		"$pkgdir/usr/lib/libfplinux-contacts.so.1"
	ln -s libfplinux-contacts.so.1 "$pkgdir/usr/lib/libfplinux-contacts.so"
	install -Dm644 fplinux-contacts.h \
		"$pkgdir/usr/include/fplinux/fplinux-contacts.h"
	install -Dm644 fplinux-contacts.pc \
		"$pkgdir/usr/lib/pkgconfig/fplinux-contacts.pc"
}

