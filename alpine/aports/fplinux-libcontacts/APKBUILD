c04bcfb890a4d1d680590c4c61a63f968acc83b8fd91c7c873c32fd1751c857637d99e598e8fb5bc1e4fef7b3bd7176ff6ab4c46abf5aa9c8f2f97efebb9ab4f  fplinux-contacts.h
bca571b62bbbc615e9e611d09db42eff8426d78fe8e9d2dc387e11b5502bc15d0d80a75f12cd4f7934b5c91c0d337702f96b8d95a21cd22d55511a33af140c88  fplinux-contacts.pc
d0e3b713d9a38f288acd741aa791db47864fc9e238d2fd0979d32f73e967281b2afc48ebdd22d0dda86f9cc0ad7685c64736ff13fc4cb69a80187bf41f3e4bf8  fplinux-contacts.map
