# Maintainer: FPLinux contributors <fplinux@example.invalid>
pkgname=fplinux-contacts
pkgver=1
pkgrel=0
pkgdesc="Simple vCard contacts application for FPLinux"
url="https://github.com/fplinux/fplinux"
arch="armv7"
license="GPL-2.0-only"
depends="fplinux-ui fplinux-libcontacts"
makedepends_build="clang22 lld22 pkgconf gettext"
makedepends_host="musl-dev musl-libintl linux-headers fplinux-ui-dev fplinux-libcontacts-dev"
options="!check"
source="
	fplinux-contacts.c
	fplinux-cli.c
	fplinux-cli.h
	org.fplinux.contacts.desktop
	ru.po
"
builddir="$srcdir"

build() {
	export PKG_CONFIG_SYSROOT_DIR="$CBUILDROOT"
	export PKG_CONFIG_LIBDIR="$CBUILDROOT/usr/lib/pkgconfig:$CBUILDROOT/usr/share/pkgconfig"
	"$CC" $CPPFLAGS $CFLAGS -Os -std=c11 -Wall -Wextra -Werror \
		-I"$srcdir" \
		$(pkg-config --cflags fplinux-ui fplinux-contacts) \
		fplinux-contacts.c fplinux-cli.c \
		$(pkg-config --libs fplinux-ui fplinux-contacts) \
		$LDFLAGS -Wl,--gc-sections -o fplinux-contacts
	msgfmt --check --output-file=ru.mo ru.po
}

package() {
	install -Dm755 "$builddir/fplinux-contacts" \
		"$pkgdir/usr/bin/fplinux-contacts"
	install -Dm644 "$srcdir/org.fplinux.contacts.desktop" \
		"$pkgdir/usr/share/applications/org.fplinux.contacts.desktop"
	install -Dm644 "$builddir/ru.mo" \
		"$pkgdir/usr/share/locale/ru/LC_MESSAGES/org.fplinux.contacts.mo"
}

