+/*
+ * Reboot straight into the BootROM download mode.  The stock key sequence is
+ * only one way to enter it: the BootROM also checks PMIC_RST_STATUS after a
+ * full PMIC watchdog reset.  HWRST_STATUS_AUTODLOADER is that reset reason.
+ *
+ * UMS9117's PMIC watchdog is at base 0x40, not the sc9860 0x80 used by the
+ * generic restart helper, and the clocks are 0xc08/0xc10 (see fdl/src/entry.c
+ * and fdl/src/main.c).  Everything runs under the ADI user lock because the
+ * final sys-off notifier must not sleep in the SPI message queue.
+ */
+static int sprd_adi_arm_bootrom_reset(struct sprd_adi *sadi, const char *cmd)
+{
+#define UMS9117_PMIC_RST_STATUS	0xee8U
+#define UMS9117_PMIC_MODULE_EN	0xc08U
+#define UMS9117_PMIC_RTC_EN	0xc10U
+#define UMS9117_WDG_BASE	0x40U
+#define UMS9117_WDG_UNLOCK	0xe551U
+#define UMS9117_WDG_LOCKED	0x1aaeU
+#define UMS9117_WDG_TIMEOUT	32768U
+	unsigned long flags;
+	u32 value;
+	int ret;
+	int end_ret;
+
+	if (!cmd || (strncmp(cmd, "autodloader", 11) &&
+		     strncmp(cmd, "bootrom", 7)))
+		return NOTIFY_DONE;
+	if (!sadi->data->user_lock)
+		return -EOPNOTSUPP;
+
+	ret = sprd_adi_user_lock(sadi, &flags);
+	if (ret)
+		return ret;
+
+	/* Clear the normal/watchdog reset reason and request download mode. */
+	ret = sprd_adi_read(sadi, UMS9117_PMIC_RST_STATUS, &value);
+	if (!ret) {
+		value &= ~HWRST_STATUS_WATCHDOG;
+		value |= HWRST_STATUS_AUTODLOADER;
+		ret = sprd_adi_write(sadi, UMS9117_PMIC_RST_STATUS, value);
+	}
+
+	/* The PMIC watchdog clocks are bit 2 on UMS9117/SC2720. */
+	if (!ret)
+		ret = sprd_adi_read(sadi, UMS9117_PMIC_MODULE_EN, &value);
+	if (!ret)
+		ret = sprd_adi_write(sadi, UMS9117_PMIC_MODULE_EN,
+				     value | BIT_WDG_EN);
+	if (!ret)
+		ret = sprd_adi_read(sadi, UMS9117_PMIC_RTC_EN, &value);
+	if (!ret)
+		ret = sprd_adi_write(sadi, UMS9117_PMIC_RTC_EN,
+				     value | BIT_WDG_EN);
+
+	/*
+	 * ADI writes are posted through a FIFO: sprd_adi_write() only drains
+	 * previous transactions, and a following sprd_adi_read() can still
+	 * observe the old value.  A read-modify-write after every step loses
+	 * the bit set by the previous step (the failed attempt left only the
+	 * NEW bit, ctrl=0x4).  Read CTRL once, accumulate every bit locally,
+	 * and commit it in a single write as the FDL sequence intends.
+	 */
+	if (!ret)
+		ret = sprd_adi_write(sadi, UMS9117_WDG_BASE + REG_WDG_LOCK,
+				     UMS9117_WDG_UNLOCK);
+	if (!ret)
+		ret = sprd_adi_read(sadi, UMS9117_WDG_BASE + REG_WDG_CTRL,
+				    &value);
+	if (!ret) {
+		value |= BIT_WDG_NEW | BIT_WDG_RST;
+		ret = sprd_adi_write(sadi, UMS9117_WDG_BASE + REG_WDG_LOAD_HIGH,
+				     (UMS9117_WDG_TIMEOUT >> 16) & 0xffff);
+	}
+	if (!ret)
+		ret = sprd_adi_write(sadi, UMS9117_WDG_BASE + REG_WDG_LOAD_LOW,
+				     UMS9117_WDG_TIMEOUT & 0xffff);
+	if (!ret) {
+		value |= BIT_WDG_RUN;
+		ret = sprd_adi_write(sadi, UMS9117_WDG_BASE + REG_WDG_CTRL,
+				     value);
+	}
+	if (!ret)
+		ret = sprd_adi_write(sadi, UMS9117_WDG_BASE + REG_WDG_LOCK,
+				     UMS9117_WDG_LOCKED);
+	if (!ret)
+		ret = sprd_adi_drain_fifo(sadi);
+	if (!ret) {
+		u32 dbg;
+
+		if (!sprd_adi_read(sadi, UMS9117_WDG_BASE + REG_WDG_CTRL,
+				   &dbg))
+			dev_emerg(sadi->dev,
+				  "BootROM watchdog ctrl=0x%x\n", dbg);
+		if (!sprd_adi_read(sadi, UMS9117_PMIC_RST_STATUS, &dbg))
+			dev_emerg(sadi->dev,
+				  "BootROM reset status=0x%x\n", dbg);
+	}
+
+	end_ret = sprd_adi_user_unlock(sadi, flags);
+	if (!ret)
+		ret = end_ret;
+	if (ret)
+		dev_emerg(sadi->dev, "BootROM reboot failed: %d\n", ret);
+	else
+		dev_emerg(sadi->dev, "Rebooting into BootROM download mode\n");
+
+	/* One second at 32.768 kHz; give USB and the PMIC time to reset. */
+	mdelay(1500);
+	return NOTIFY_DONE;
+}
