+/* The final sys-off notifier cannot sleep in the SPI message queue. */
+int sprd_adi_sc2720_power_off(struct spi_device *spi)
+{
+	/* Same register sequence as the mainline SC27xx power-off driver. */
+#define SC27XX_SLP_CTRL		0xdf0
+#define SC27XX_LDO_XTL_EN	BIT(3)
+#define SC27XX_PWR_PD_HW	0xc2c
+#define SC27XX_PWR_OFF_EN	BIT(0)
+	struct sprd_adi *sadi = spi_controller_get_devdata(spi->controller);
+	unsigned long flags;
+	u32 value;
+	int ret;
+	int end_ret;
+
+	if (!sadi->data->user_lock)
+		return -EOPNOTSUPP;
+	ret = sprd_adi_user_lock(sadi, &flags);
+	if (ret)
+		return ret;
+	ret = sprd_adi_read(sadi, 0xc00, &value);
+	if (!ret && value != 0xa003)
+		ret = -ENODEV;
+	if (!ret)
+		ret = sprd_adi_read(sadi, 0xc04, &value);
+	if (!ret && value != 0x2720)
+		ret = -ENODEV;
+	/* Disable the external subsystem connection before cutting power. */
+	if (!ret)
+		ret = sprd_adi_write(sadi, SC27XX_SLP_CTRL, SC27XX_LDO_XTL_EN);
+	if (!ret)
+		ret = sprd_adi_write(sadi, SC27XX_PWR_PD_HW, SC27XX_PWR_OFF_EN);
+	if (!ret)
+		ret = sprd_adi_drain_fifo(sadi);
+	end_ret = sprd_adi_user_unlock(sadi, flags);
+	return ret ? ret : end_ret;
+}
+EXPORT_SYMBOL_GPL(sprd_adi_sc2720_power_off);
