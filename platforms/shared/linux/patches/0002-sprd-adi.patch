+static void sprd_adi_remove_bootrom_sysfs(void *data)
+{
+	sysfs_remove_file(bootrom_kobj, &bootrom_attr.attr);
+	kobject_put(bootrom_kobj);
+	bootrom_kobj = NULL;
+	bootrom_sadi = NULL;
+}
