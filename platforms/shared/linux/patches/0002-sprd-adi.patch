+static int sprd_adi_restart_ums9117(struct sys_off_data *data)
+{
+	struct sprd_adi *sadi = data->cb_data;
+
+	/* The high-priority reboot notifier has already armed the watchdog. */
+	if (sadi->bootrom_armed)
+		return NOTIFY_DONE;
+	return sprd_adi_arm_bootrom_reset(sadi, data->cmd);
+}
+
+/*
+ * device_shutdown() runs before sys-off handlers and takes tens of seconds on
+ * this phone, leaving the screen frozen long after `reboot`. Arm the same PMIC
+ * watchdog from a high-priority reboot notifier so the reset starts at once;
+ * the sys-off handler above then becomes a no-op for this path.
+ */
+static int sprd_adi_bootrom_reboot_notifier(struct notifier_block *nb,
+					    unsigned long action, void *cmd)
+{
+	struct sprd_adi *sadi = container_of(nb, struct sprd_adi, bootrom_nb);
+
+	if (action != SYS_RESTART || sadi->bootrom_armed || !cmd)
+		return NOTIFY_DONE;
+	if (strncmp(cmd, "autodloader", 11) && strncmp(cmd, "bootrom", 7))
+		return NOTIFY_DONE;
+
+	sadi->bootrom_armed = true;
+	sprd_adi_arm_bootrom_reset(sadi, cmd);
+	return NOTIFY_DONE;
+}
+
+static void sprd_adi_unregister_bootrom_notifier(void *data)
+{
+	struct sprd_adi *sadi = data;
+
+	unregister_reboot_notifier(&sadi->bootrom_nb);
+}
+
+/* Direct trigger: no reboot notifiers, no device_shutdown(), no long freeze. */
+static struct kobject *bootrom_kobj;
+static struct sprd_adi *bootrom_sadi;
+
+static ssize_t bootrom_store(struct kobject *kobj, struct kobj_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct sprd_adi *sadi = bootrom_sadi;
+
+	if (!sadi || !count)
+		return -ENODEV;
+	sadi->bootrom_armed = true;
+	sprd_adi_arm_bootrom_reset(sadi, "autodloader");
+	return count;
+}
+static struct kobj_attribute bootrom_attr = __ATTR_WO(bootrom);
